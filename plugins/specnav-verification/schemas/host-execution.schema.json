{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/host-execution.schema.json",
  "title": "SpecNav Verification 2.0 Host Execution Fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "run_id",
    "host",
    "status",
    "repository",
    "ref",
    "commit",
    "host_lock_sha256",
    "release_gate_id",
    "archive_gate_id",
    "gate_input_sha256",
    "evidence_index_digest",
    "runtime_authority_digest",
    "host_authority_digest",
    "source_snapshot_digest",
    "runner_identity_sha256",
    "environment_sha256",
    "commands",
    "blocker",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.host-execution.v1"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "host": {
      "enum": [
        "claude-code",
        "codex",
        "codefree-o"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
    },
    "ref": {
      "type": "string",
      "pattern": "^refs/(?:heads|tags)/[A-Za-z0-9._/-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "host_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "release_gate_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "archive_gate_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "gate_input_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "evidence_index_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runtime_authority_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "host_authority_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_snapshot_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runner_identity_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "environment_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "executable_realpath",
          "executable_sha256",
          "exit_status",
          "signal",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_path",
          "stderr_path",
          "started_at",
          "completed_at"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            }
          },
          "executable_realpath": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "executable_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "exit_status": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              {
                "type": "null"
              }
            ]
          },
          "stdout_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "stderr_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "stdout_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "stderr_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "started_at": {
            "$ref": "common.schema.json#/$defs/dateTime"
          },
          "completed_at": {
            "$ref": "common.schema.json#/$defs/dateTime"
          }
        }
      }
    },
    "blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "artifact",
            "detail"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "artifact": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "detail": {}
          }
        }
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "completed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exit_status": {
                  "const": 0
                },
                "signal": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "object"
          }
        }
      }
    }
  ]
}
